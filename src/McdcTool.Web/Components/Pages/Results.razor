@page "/results"
@using McdcTool.Core.Models
@using McdcTool.Web.Services
@inject McdcAnalysisService AnalysisService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>MC/DC Analysis Results</PageTitle>

@if (results == null || results.Count == 0)
{
    <div class="alert alert-warning">
        No analysis results available. <a href="/">Go back to file selection</a>.
    </div>
    return;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>MC/DC Analysis Results</h3>
    <div>
        <button class="btn btn-outline-primary me-2" @onclick="GoBack">Back to File Selection</button>
        <button class="btn btn-outline-success me-2" @onclick="ShowProjectDialog">Generate Test Project</button>
        <button class="btn btn-primary" @onclick="ShowExportDialog">Export All Tests</button>
    </div>
</div>

<div class="alert alert-info py-2">
    Found <strong>@results.Count</strong> decision(s) across
    <strong>@results.Select(r => r.Decision.FilePath).Distinct().Count()</strong> file(s).
    Total test cases generated: <strong>@results.Sum(r => r.Result.MinimalTestSet.Count)</strong>
</div>

<!-- Coverage Summary -->
@if (coverageReport != null)
{
    <div class="card mb-3 border-secondary">
        <div class="card-header d-flex justify-content-between align-items-center"
             style="cursor: pointer" @onclick="() => showCoverageDetails = !showCoverageDetails">
            <strong>Coverage Summary (Static Estimate)</strong>
            <span>@(showCoverageDetails ? "\u25B2" : "\u25BC")</span>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="d-flex justify-content-between mb-1">
                        <span><strong>Statement Coverage</strong></span>
                        <span>@coverageReport.CoveredStatements / @coverageReport.TotalStatements
                            (@coverageReport.StatementCoveragePercent.ToString("F1")%)</span>
                    </div>
                    <div class="progress" style="height: 22px;">
                        <div class="progress-bar @StatementProgressClass(coverageReport.StatementCoveragePercent)"
                             role="progressbar"
                             style="width: @coverageReport.StatementCoveragePercent.ToString("F1")%"
                             aria-valuenow="@coverageReport.StatementCoveragePercent"
                             aria-valuemin="0" aria-valuemax="100">
                            @coverageReport.StatementCoveragePercent.ToString("F1")%
                        </div>
                    </div>
                    <small class="text-muted">Statements in methods containing analyzed decisions</small>
                </div>
                <div class="col-md-6">
                    <div class="d-flex justify-content-between mb-1">
                        <span><strong>Decision Coverage</strong></span>
                        <span>@coverageReport.CoveredDecisions / @coverageReport.TotalDecisions
                            (@coverageReport.DecisionCoveragePercent.ToString("F1")%)</span>
                    </div>
                    <div class="progress" style="height: 22px;">
                        <div class="progress-bar @DecisionProgressClass(coverageReport.DecisionCoveragePercent)"
                             role="progressbar"
                             style="width: @coverageReport.DecisionCoveragePercent.ToString("F1")%"
                             aria-valuenow="@coverageReport.DecisionCoveragePercent"
                             aria-valuemin="0" aria-valuemax="100">
                            @coverageReport.DecisionCoveragePercent.ToString("F1")%
                        </div>
                    </div>
                    <small class="text-muted">Decisions where test set covers both T and F outcomes</small>
                </div>
            </div>

            @if (showCoverageDetails && coverageReport.Files.Count > 1)
            {
                <hr />
                <h6 class="mt-2">Per-File Breakdown</h6>
                <table class="table table-sm table-bordered" style="width: auto">
                    <thead class="table-light">
                        <tr>
                            <th>File</th>
                            <th class="text-center">Statements</th>
                            <th class="text-center">Stmt %</th>
                            <th class="text-center">Decisions</th>
                            <th class="text-center">Decision %</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fc in coverageReport.Files)
                        {
                            <tr>
                                <td><small>@Path.GetFileName(fc.FilePath)</small></td>
                                <td class="text-center">@fc.CoveredStatements / @fc.TotalStatements</td>
                                <td class="text-center">
                                    <span class="badge @BadgeClass(fc.StatementCoveragePercent)">
                                        @fc.StatementCoveragePercent.ToString("F1")%
                                    </span>
                                </td>
                                <td class="text-center">@fc.CoveredDecisions / @fc.TotalDecisions</td>
                                <td class="text-center">
                                    <span class="badge @BadgeClass(fc.DecisionCoveragePercent)">
                                        @fc.DecisionCoveragePercent.ToString("F1")%
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

<!-- Export dialog -->
@if (showExportDialog)
{
    <div class="card mb-3 border-primary">
        <div class="card-body">
            <label class="form-label fw-bold">Export test files to directory:</label>
            <div class="input-group">
                <input type="text" class="form-control" @bind="exportPath" placeholder="./McdcTests" />
                <button class="btn btn-primary" @onclick="ExportAll">Export</button>
                <button class="btn btn-outline-secondary" @onclick="() => showExportDialog = false">Cancel</button>
            </div>
            @if (!string.IsNullOrEmpty(exportMessage))
            {
                <div class="alert @(exportSuccess ? "alert-success" : "alert-danger") mt-2 py-1">@exportMessage</div>
            }
        </div>
    </div>
}

<!-- Generate Test Project dialog -->
@if (showProjectDialog)
{
    <div class="card mb-3 border-success">
        <div class="card-body">
            <label class="form-label fw-bold">Generate runnable test project to directory:</label>
            <div class="input-group">
                <input type="text" class="form-control" @bind="projectPath" placeholder="./McdcTestProject" />
                <button class="btn btn-success" @onclick="GenerateProject">Generate</button>
                <button class="btn btn-outline-secondary" @onclick="() => showProjectDialog = false">Cancel</button>
            </div>
            @if (!string.IsNullOrEmpty(projectMessage))
            {
                <div class="alert @(projectSuccess ? "alert-success" : "alert-danger") mt-2 py-1">
                    @projectMessage
                    @if (projectSuccess)
                    {
                        <br /><small>Run: <code>cd @Path.GetFullPath(projectPath) && dotnet test</code></small>
                    }
                </div>
            }
        </div>
    </div>
}

@foreach (var (analysis, index) in results.Select((a, i) => (a, i)))
{
    var result = analysis.Result;
    var decision = analysis.Decision;
    var isExpanded = expandedCards.Contains(index);

    <div class="card mb-3">
        <div class="card-header" style="cursor: pointer" @onclick="() => ToggleCard(index)">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="badge bg-secondary me-1">@decision.StatementType</span>
                    <strong>@Path.GetFileName(decision.FilePath):@decision.LineNumber</strong>
                    <code class="ms-2">@result.ExpressionText</code>
                </div>
                <div>
                    <span class="badge bg-info me-1">@result.ConditionMappings.Count conditions</span>
                    <span class="badge bg-success me-1">@result.MinimalTestSet.Count tests</span>
                    @if (analysis.IsDecisionCovered)
                    {
                        <span class="badge bg-success me-1" title="Both true and false outcomes covered">Decision ✓</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark me-1" title="Only one decision outcome covered">Decision !</span>
                    }
                    <span class="ms-1">@(isExpanded ? "\u25B2" : "\u25BC")</span>
                </div>
            </div>
        </div>

        @if (isExpanded)
        {
            <div class="card-body">
                <!-- Condition Mappings -->
                <h6>Condition Mappings</h6>
                <div class="mb-3">
                    <table class="table table-sm table-bordered" style="width: auto">
                        <thead class="table-light">
                            <tr><th>Label</th><th>Condition</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var (label, text) in result.ConditionMappings.OrderBy(kv => kv.Key))
                            {
                                <tr><td><strong>@label</strong></td><td><code>@text</code></td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Truth Table -->
                <h6>Truth Table (@result.TruthTable.Rows.Count rows)</h6>
                <div class="mb-3 table-responsive" style="max-height: 300px; overflow-y: auto;">
                    <table class="table table-sm table-bordered table-hover" style="width: auto">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th>Row</th>
                                @foreach (var label in result.TruthTable.ConditionLabels)
                                {
                                    <th class="text-center">@label</th>
                                }
                                <th class="text-center">Result</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in result.TruthTable.Rows)
                            {
                                var isTestRow = result.MinimalTestSet.Any(tc => tc.Row.RowIndex == row.RowIndex);
                                <tr class="@(isTestRow ? "table-warning" : "")">
                                    <td>@row.RowIndex</td>
                                    @foreach (var label in result.TruthTable.ConditionLabels)
                                    {
                                        <td class="text-center">
                                            <span class="@(row.ConditionValues[label] ? "text-success fw-bold" : "text-danger")">
                                                @(row.ConditionValues[label] ? "T" : "F")
                                            </span>
                                        </td>
                                    }
                                    <td class="text-center">
                                        <span class="@(row.DecisionOutcome ? "text-success fw-bold" : "text-danger")">
                                            @(row.DecisionOutcome ? "T" : "F")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <small class="text-muted">Highlighted rows are selected for the minimal MC/DC test set.</small>
                </div>

                <!-- Independence Pairs -->
                <h6>Independence Pairs</h6>
                <div class="mb-3">
                    @foreach (var label in result.TruthTable.ConditionLabels)
                    {
                        var pairs = result.IndependencePairs[label];
                        <div class="mb-1">
                            <strong>@label</strong>: @pairs.Count pair(s)
                            @if (pairs.Count > 0)
                            {
                                <span class="text-muted ms-2">
                                    @string.Join(", ", pairs.Select(p => $"({p.TrueRow.RowIndex},{p.FalseRow.RowIndex})"))
                                </span>
                            }
                            else
                            {
                                <span class="text-danger ms-2">No independence pairs found</span>
                            }
                        </div>
                    }
                </div>

                <!-- Minimal Test Set -->
                <h6>Minimal MC/DC Test Set (@result.MinimalTestSet.Count test cases)</h6>
                <div class="mb-3">
                    <table class="table table-sm table-bordered" style="width: auto">
                        <thead class="table-light">
                            <tr>
                                <th>Row</th>
                                @foreach (var label in result.TruthTable.ConditionLabels)
                                {
                                    <th class="text-center">@label</th>
                                }
                                <th class="text-center">Expected</th>
                                <th>Covers</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tc in result.MinimalTestSet)
                            {
                                <tr>
                                    <td>@tc.Row.RowIndex</td>
                                    @foreach (var label in result.TruthTable.ConditionLabels)
                                    {
                                        <td class="text-center">
                                            <span class="@(tc.Row.ConditionValues[label] ? "text-success fw-bold" : "text-danger")">
                                                @(tc.Row.ConditionValues[label] ? "T" : "F")
                                            </span>
                                        </td>
                                    }
                                    <td class="text-center">
                                        <span class="@(tc.Row.DecisionOutcome ? "text-success fw-bold" : "text-danger")">
                                            @(tc.Row.DecisionOutcome ? "T" : "F")
                                        </span>
                                    </td>
                                    <td>@string.Join(", ", tc.CoversConditions)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Generated Test Code -->
                <h6>Generated xUnit Test Code</h6>
                <div class="mb-3">
                    <button class="btn btn-sm btn-outline-secondary mb-1" @onclick="() => CopyToClipboard(analysis.TestCode)">
                        Copy to Clipboard
                    </button>
                    <pre class="border rounded p-3 bg-light" style="max-height: 400px; overflow-y: auto;"><code>@analysis.TestCode</code></pre>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<AnalysisResult>? results;
    private CoverageReport? coverageReport;
    private HashSet<int> expandedCards = new();
    private bool showCoverageDetails;

    private bool showExportDialog;
    private string exportPath = "./McdcTests";
    private string exportMessage = "";
    private bool exportSuccess;

    private bool showProjectDialog;
    private string projectPath = "./McdcTestProject";
    private string projectMessage = "";
    private bool projectSuccess;

    protected override void OnInitialized()
    {
        results = Home.LastResults;
        coverageReport = Home.LastCoverageReport;
        // Auto-expand the first card
        if (results != null && results.Count > 0)
            expandedCards.Add(0);
    }

    private void ToggleCard(int index)
    {
        if (!expandedCards.Remove(index))
            expandedCards.Add(index);
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }

    private void ShowExportDialog()
    {
        showExportDialog = true;
        exportMessage = "";
    }

    private void ExportAll()
    {
        if (results == null) return;

        try
        {
            AnalysisService.ExportTestFiles(results, exportPath);
            exportSuccess = true;
            exportMessage = $"Exported {results.Count} test file(s) to: {Path.GetFullPath(exportPath)}";
        }
        catch (Exception ex)
        {
            exportSuccess = false;
            exportMessage = $"Export failed: {ex.Message}";
        }
    }

    private void ShowProjectDialog()
    {
        showProjectDialog = true;
        projectMessage = "";
    }

    private void GenerateProject()
    {
        if (results == null) return;

        try
        {
            var sourceFiles = Home.LastAnalyzedFiles ?? results.Select(r => r.Decision.FilePath).Distinct().ToList();
            AnalysisService.GenerateTestProject(sourceFiles, results, projectPath);
            projectSuccess = true;
            projectMessage = $"Test project generated at: {Path.GetFullPath(projectPath)}";
        }
        catch (Exception ex)
        {
            projectSuccess = false;
            projectMessage = $"Generation failed: {ex.Message}";
        }
    }

    private async Task CopyToClipboard(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch
        {
            // Clipboard API may not be available in all contexts
        }
    }

    private static string StatementProgressClass(double pct) =>
        pct >= 80 ? "bg-success" : pct >= 50 ? "bg-warning" : "bg-danger";

    private static string DecisionProgressClass(double pct) =>
        pct >= 100 ? "bg-success" : pct >= 75 ? "bg-warning" : "bg-danger";

    private static string BadgeClass(double pct) =>
        pct >= 80 ? "bg-success" : pct >= 50 ? "bg-warning text-dark" : "bg-danger";
}
